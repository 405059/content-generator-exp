# IDE Files (IntelliJ/PyCharm/VSCode settings)
.idea/
.vscode/

# Python Cache
__pycache__/
*.pyc
*.py[cod]
*$py.class
*.so

# Python virtual environments
venv/
env/
ENV/
.venv/

# Python package artifacts
*.egg-info/
dist/
build/

# Environment variables (DO NOT COMMIT API KEYS!)
.env

# Logs and temporary files
*.log
*.tmp

# Git LFS cache (尽管你删了.git，但以防万一)
.git/lfs/